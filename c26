#include <stdio.h>
int valid(int matrix[9][9],int n)
{
    int num;
    for(int i=0;i<n;i++)
    {
        int seen[10]={0};
        for(int j=0;j<n;j++)
        {
             num=matrix[i][j];
            if(num<1||num>9||seen[num])
            {
                return 0;
            }
            seen[num]=1;
        }
    }
    for(int j=0;j<n;j++)
    {
        int seen[10]={0};
        for(int i=0;i<n;i++)
        {
             num=matrix[i][j];
            if(num<1||num>9||seen[num])
            {
                return 0;
            }
            seen[num]=1;
        }
    }
    return 1;
}

int main()
{
    int n;
    scanf("%d", &n);

    int matrix[n][n];

    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < n; j++)
        {
            scanf("%d", &matrix[i][j]);
        }
    }
    
   if(valid(matrix,n))
   {
       printf("valid");
   }
   else
   {
       printf("not valid");
   }

    return 0;
}
